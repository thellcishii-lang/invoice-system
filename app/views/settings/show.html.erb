<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-3xl mb-5">事業者マスター・設定</h1>

  <% if @tenant.errors.any? %>
    <div class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg">
      <ul>
        <% @tenant.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @tenant, url: setting_path, method: :patch, class: "contents" do |form| %>
    <h2 class="font-bold text-xl mt-4 mb-3">事業者マスター（自社情報）</h2>

    <div class="my-5">
      <%= form.label :name, "会社名" %>
      <%= form.text_field :name, required: true, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :invoice_registration_number, "適格請求書発行事業者の登録番号" %>
      <%= form.text_field :invoice_registration_number, placeholder: "T1234567890123", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :postal_code, "郵便番号" %>
      <%= form.text_field :postal_code, placeholder: "100-0001", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :address, "住所" %>
      <%= form.text_field :address, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :phone, "電話番号" %>
      <%= form.text_field :phone, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :email, "メールアドレス" %>
      <%= form.email_field :email, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :seal_image, "印鑑画像（PNG/JPEG）" %>
      <div data-controller="image-drop">
        <div data-image-drop-target="zone" data-action="click->image-drop#open dragover->image-drop#dragOver dragleave->image-drop#dragLeave drop->image-drop#drop"
             class="mt-2 border-2 border-dashed border-gray-300 rounded-lg p-4 text-center cursor-pointer hover:border-blue-400">
          <% if @tenant.seal_image? %>
            <%= image_tag @tenant.seal_image_data_uri, alt: "印鑑", data: { image_drop_target: "preview" }, class: "mx-auto w-20 h-20 object-contain" %>
          <% else %>
            <img data-image-drop-target="preview" alt="" class="mx-auto w-20 h-20 object-contain hidden">
          <% end %>
          <span class="btn btn-primary mt-2">画像を選ぶ</span>
          <p class="text-gray-500 text-sm mt-2">またはここに画像をドラッグ＆ドロップ</p>
        </div>
        <%= form.file_field :seal_image, accept: "image/png,image/jpeg", class: "hidden", data: { image_drop_target: "input", action: "change->image-drop#picked" } %>
        <% if @tenant.seal_image? %>
          <label class="block mt-2 text-sm">
            <%= form.check_box :remove_seal, class: "mr-1" %> 印鑑画像を削除する
          </label>
        <% end %>
      </div>
      <p class="text-gray-500 text-sm mt-1">帳票の会社名の横に表示されます。メールで送る帳票にも付きます。大きな画像は自動で縮小されます。</p>
    </div>

    <div class="my-5">
      <%= form.label :logo_image, "ロゴ画像（PNG/JPEG）" %>
      <div data-controller="image-drop">
        <div data-image-drop-target="zone" data-action="click->image-drop#open dragover->image-drop#dragOver dragleave->image-drop#dragLeave drop->image-drop#drop"
             class="mt-2 border-2 border-dashed border-gray-300 rounded-lg p-4 text-center cursor-pointer hover:border-blue-400">
          <% if @tenant.logo_image? %>
            <%= image_tag @tenant.logo_image_data_uri, alt: "ロゴ", data: { image_drop_target: "preview" }, class: "mx-auto h-12 object-contain" %>
          <% else %>
            <img data-image-drop-target="preview" alt="" class="mx-auto h-12 object-contain hidden">
          <% end %>
          <span class="btn btn-primary mt-2">画像を選ぶ</span>
          <p class="text-gray-500 text-sm mt-2">またはここに画像をドラッグ＆ドロップ</p>
        </div>
        <%= form.file_field :logo_image, accept: "image/png,image/jpeg", class: "hidden", data: { image_drop_target: "input", action: "change->image-drop#picked" } %>
        <% if @tenant.logo_image? %>
          <label class="block mt-2 text-sm">
            <%= form.check_box :remove_logo, class: "mr-1" %> ロゴ画像を削除する
          </label>
        <% end %>
      </div>
      <p class="text-gray-500 text-sm mt-1">帳票の帯の上、または一番下に表示されます。高さは帯より少し大きめです。大きな画像は自動で縮小されます。</p>
    </div>

    <div class="my-5">
      <%= form.label :logo_placement, "ロゴの表示位置" %>
      <%= form.select :logo_placement, [ [ "上部（帯の上）", "top" ], [ "下部（一番下）", "bottom" ] ], {}, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :logo_alignment, "ロゴの寄せ" %>
      <%= form.select :logo_alignment, [ [ "左端", "left" ], [ "中央", "center" ], [ "右端", "right" ] ], {}, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <h3 class="font-bold text-lg mt-8 mb-3">振込先口座（請求書に記載）</h3>

    <div class="my-5">
      <%= form.label :bank_name, "銀行名" %>
      <%= form.text_field :bank_name, placeholder: "例: 〇〇銀行", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :bank_branch, "支店名" %>
      <%= form.text_field :bank_branch, placeholder: "例: 〇〇支店", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :bank_account_type, "口座種別" %>
      <%= form.select :bank_account_type, [ [ "普通", "普通" ], [ "当座", "当座" ] ], { include_blank: true }, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :bank_account_number, "口座番号" %>
      <%= form.text_field :bank_account_number, placeholder: "例: 1234567", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :bank_account_holder, "口座名義" %>
      <%= form.text_field :bank_account_holder, placeholder: "例: エブリワンズゴウドウガイシャ", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
      <p class="text-gray-500 text-sm mt-1">振込先は請求書の下部に「銀行名 支店名 種別 番号／口座名義」の形で表示されます。</p>
    </div>

    <h2 class="font-bold text-xl mt-8 mb-3">製品エディション</h2>

    <div class="my-5">
      <%= form.label :edition, "エディション" %>
      <%= form.select :edition,
            Tenant::EDITION_LABELS.map { |value, label| [ label, value ] },
            {}, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
      <p class="text-gray-500 text-sm mt-1">建築を選ぶと、見積書の印刷が建築様式（表紙＋内訳集計＋分類別明細・横書き）になります。本番では申込時に決まります（ここでは確認のため切り替えできます）。</p>
    </div>

    <h2 class="font-bold text-xl mt-8 mb-3">帳票の設定</h2>

    <div class="my-5">
      <%= form.label :document_number_prefix, "帳票番号の接頭辞" %>
      <%= form.text_field :document_number_prefix, placeholder: "例: INV-", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :tax_rounding, "消費税の端数処理" %>
      <%= form.select :tax_rounding,
            [ [ "切り捨て", "floor" ], [ "四捨五入", "round" ], [ "切り上げ", "ceil" ] ],
            {}, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :tax_display, "税表示" %>
      <%= form.select :tax_display,
            [ [ "税抜", "exclusive" ], [ "税込", "inclusive" ] ],
            {}, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <h3 class="font-bold text-lg mt-8 mb-3">帳票のデザイン</h3>

    <div class="my-5">
      <%= form.label :document_color, "帯の色" %>
      <div class="flex items-center gap-3 mt-2">
        <%= form.color_field :document_color, value: @tenant.document_color.presence || "#2f4d6e", class: "h-10 w-20 rounded-md border border-gray-400 bg-white p-1 cursor-pointer" %>
        <span class="text-sm text-gray-600"><%= @tenant.document_color.present? ? "カスタム色（#{@tenant.document_color}）を使用中" : "現在はデフォルト（種別ごとの色）" %></span>
      </div>
      <label class="flex items-center gap-2 mt-2 text-sm">
        <%= check_box_tag "tenant[document_color_reset]", "1", false, class: "rounded border-gray-400" %>
        デフォルトの色に戻す
      </label>
      <p class="text-gray-500 text-sm mt-1">色を選ぶと、すべての帳票の帯がその色の淡色になります。</p>
    </div>

    <div class="my-5">
      <label class="flex items-center gap-2">
        <%= form.check_box :document_striped, class: "rounded border-gray-400" %>
        明細の行をシマシマ（縞模様）にする
      </label>
    </div>

    <div class="my-5">
      <%= form.label :document_pattern, "背景の柄" %>
      <%= form.select :document_pattern,
            Tenant::DOCUMENT_PATTERN_LABELS.map { |value, label| [ label, value ] },
            {}, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <h2 class="font-bold text-xl mt-8 mb-3">メール送信（SMTP）設定</h2>
    <p class="text-gray-500 text-sm mb-3">
      自分のメールアドレスから帳票を送りたい場合は、普段お使いのメールの SMTP 設定を入力してください。
      未設定の場合は、システムのアドレスから送信されます（返信は御社のアドレスに届きます）。
      例：Zoho Mail は smtp.zoho.jp / ポート 465、Gmail は smtp.gmail.com / ポート 587（アプリパスワードが必要）です。
    </p>

    <div class="my-5">
      <%= form.label :smtp_from_address, "差出人メールアドレス" %>
      <%= form.email_field :smtp_from_address, placeholder: "例: info@your-company.co.jp", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :smtp_host, "SMTPサーバー" %>
      <%= form.text_field :smtp_host, placeholder: "例: smtp.zoho.jp", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :smtp_port, "ポート" %>
      <%= form.number_field :smtp_port, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
      <p class="text-gray-500 text-sm mt-1">465 は SSL、587 は STARTTLS で接続します。</p>
    </div>

    <div class="my-5">
      <%= form.label :smtp_username, "ユーザー名" %>
      <%= form.text_field :smtp_username, autocomplete: "off", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :smtp_password, "パスワード" %>
      <%= form.password_field :smtp_password, value: "", autocomplete: "new-password", placeholder: @tenant.smtp_password_ciphertext.present? ? "設定済み（変更する場合のみ入力）" : "", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
      <p class="text-gray-500 text-sm mt-1">パスワードは暗号化して保存されます。空欄のまま保存すると、現在のパスワードを保持します。</p>
    </div>

    <% if @tenant.smtp_configured? %>
      <div class="my-5">
        <label class="flex items-center gap-2 text-sm">
          <%= check_box_tag "tenant[clear_smtp]", "1", false, class: "rounded border-gray-400" %>
          SMTP設定を削除する（システムのアドレスからの送信に戻す）
        </label>
      </div>
    <% end %>

    <div class="inline">
      <%= form.submit "保存する", class: "btn btn-primary" %>
    </div>
  <% end %>

  <% if @tenant.smtp_configured? %>
    <div class="mt-6">
      <%= button_to "テスト送信（保存済みの設定で、御社のアドレス宛に送ります）", test_smtp_setting_path, class: "btn" %>
    </div>
  <% end %>
</div>
