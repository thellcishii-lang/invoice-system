<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-3xl mb-5">設定</h1>

  <% if @tenant.errors.any? %>
    <div class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg">
      <ul>
        <% @tenant.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @tenant, url: setting_path, method: :patch, class: "contents" do |form| %>
    <h2 class="font-bold text-xl mt-4 mb-3">事業者マスター（自社情報）</h2>

    <div class="my-5">
      <%= form.label :name, "会社名" %>
      <%= form.text_field :name, required: true, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :invoice_registration_number, "適格請求書発行事業者の登録番号" %>
      <%= form.text_field :invoice_registration_number, placeholder: "T1234567890123", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :postal_code, "郵便番号" %>
      <%= form.text_field :postal_code, placeholder: "100-0001", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :address, "住所" %>
      <%= form.text_field :address, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :phone, "電話番号" %>
      <%= form.text_field :phone, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :email, "メールアドレス" %>
      <%= form.email_field :email, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :seal_image, "印鑑画像（PNG/JPEG、1MBまで）" %>
      <% if @tenant.seal_image? %>
        <div class="mt-2">
          <%= image_tag @tenant.seal_image_data_uri, alt: "印鑑", class: "w-20 h-20 object-contain border border-gray-200 rounded-md" %>
        </div>
        <label class="block mt-2 text-sm">
          <%= form.check_box :remove_seal, class: "mr-1" %> 印鑑画像を削除する
        </label>
      <% end %>
      <%= form.file_field :seal_image, accept: "image/png,image/jpeg", class: "block mt-2 w-full text-sm" %>
      <p class="text-gray-500 text-sm mt-1">帳票の会社名の横に表示されます。メールで送る帳票にも付きます。</p>
    </div>

    <h3 class="font-bold text-lg mt-8 mb-3">振込先口座（請求書に記載）</h3>

    <div class="my-5">
      <%= form.label :bank_name, "銀行名" %>
      <%= form.text_field :bank_name, placeholder: "例: 〇〇銀行", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :bank_branch, "支店名" %>
      <%= form.text_field :bank_branch, placeholder: "例: 〇〇支店", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :bank_account_type, "口座種別" %>
      <%= form.select :bank_account_type, [ [ "普通", "普通" ], [ "当座", "当座" ] ], { include_blank: true }, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :bank_account_number, "口座番号" %>
      <%= form.text_field :bank_account_number, placeholder: "例: 1234567", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :bank_account_holder, "口座名義" %>
      <%= form.text_field :bank_account_holder, placeholder: "例: エブリワンズゴウドウガイシャ", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
      <p class="text-gray-500 text-sm mt-1">振込先は請求書の下部に「銀行名 支店名 種別 番号／口座名義」の形で表示されます。</p>
    </div>

    <h2 class="font-bold text-xl mt-8 mb-3">帳票の設定</h2>

    <div class="my-5">
      <%= form.label :document_number_prefix, "帳票番号の接頭辞" %>
      <%= form.text_field :document_number_prefix, placeholder: "例: INV-", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :tax_rounding, "消費税の端数処理" %>
      <%= form.select :tax_rounding,
            [ [ "切り捨て", "floor" ], [ "四捨五入", "round" ], [ "切り上げ", "ceil" ] ],
            {}, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :tax_display, "税表示" %>
      <%= form.select :tax_display,
            [ [ "税抜", "exclusive" ], [ "税込", "inclusive" ] ],
            {}, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="inline">
      <%= form.submit "保存する", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>
