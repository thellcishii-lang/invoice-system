<div class="w-full">
  <h1 class="font-bold text-3xl mb-5">予約配信</h1>

  <h2 class="font-bold text-xl mt-6 mb-3">送信予定</h2>
  <% if @upcoming.empty? %>
    <p class="text-gray-500">送信予定の予約配信はありません。帳票の画面から予約できます。</p>
  <% else %>
    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-gray-300 text-gray-500 text-sm">
          <th class="py-2 pr-4">送信日時</th>
          <th class="py-2 pr-4">帳票</th>
          <th class="py-2 pr-4">取引先</th>
          <th class="py-2 pr-4">方法</th>
          <th class="py-2 pr-4">送信先</th>
          <th class="py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% @upcoming.each do |reservation| %>
          <tr class="border-b border-gray-200">
            <td class="py-2 pr-4 whitespace-nowrap"><%= reservation.scheduled_at.strftime("%Y/%m/%d %H:%M") %></td>
            <td class="py-2 pr-4"><%= link_to "#{reservation.document.kind_label} #{reservation.document.number}", reservation.document, class: "text-blue-600 hover:underline" %></td>
            <td class="py-2 pr-4"><%= reservation.document.client.name %></td>
            <td class="py-2 pr-4"><%= reservation.channel_label %></td>
            <td class="py-2 pr-4"><%= reservation.recipient %></td>
            <td class="py-2 text-right"><%= button_to "取り消す", cancel_scheduled_delivery_path(reservation), class: "rounded-md px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 text-sm font-medium cursor-pointer" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <h2 class="font-bold text-xl mt-10 mb-3">履歴</h2>
  <% if @history.empty? %>
    <p class="text-gray-500">履歴はまだありません。</p>
  <% else %>
    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-gray-300 text-gray-500 text-sm">
          <th class="py-2 pr-4">送信日時</th>
          <th class="py-2 pr-4">帳票</th>
          <th class="py-2 pr-4">取引先</th>
          <th class="py-2 pr-4">方法</th>
          <th class="py-2 pr-4">送信先</th>
          <th class="py-2 pr-4">状態</th>
        </tr>
      </thead>
      <tbody>
        <% @history.each do |reservation| %>
          <tr class="border-b border-gray-200">
            <td class="py-2 pr-4 whitespace-nowrap"><%= reservation.scheduled_at.strftime("%Y/%m/%d %H:%M") %></td>
            <td class="py-2 pr-4"><%= link_to "#{reservation.document.kind_label} #{reservation.document.number}", reservation.document, class: "text-blue-600 hover:underline" %></td>
            <td class="py-2 pr-4"><%= reservation.document.client.name %></td>
            <td class="py-2 pr-4"><%= reservation.channel_label %></td>
            <td class="py-2 pr-4"><%= reservation.recipient %></td>
            <td class="py-2 pr-4">
              <% if reservation.status == "sent" %>
                <span class="rounded-full bg-green-100 text-green-800 px-2 py-0.5 text-xs font-medium">送信済み</span>
              <% elsif reservation.status == "failed" %>
                <span class="rounded-full bg-red-100 text-red-800 px-2 py-0.5 text-xs font-medium">送信不可</span>
                <% if reservation.error_message.present? %><div class="text-red-600 text-xs mt-1"><%= reservation.error_message %></div><% end %>
              <% else %>
                <span class="rounded-full bg-gray-100 text-gray-600 px-2 py-0.5 text-xs font-medium">取消済み</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
