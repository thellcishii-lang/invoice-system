<div class="w-full">
  <h1 class="font-bold text-3xl mb-4">ダッシュボード</h1>

  <p class="text-gray-700 mb-6"><%= @tenant.name %> としてログインしています。</p>

  <div class="grid grid-cols-3 gap-4 max-w-3xl">
    <div class="rounded-lg border border-gray-200 p-4">
      <p class="text-sm text-gray-500">今月の請求額</p>
      <p class="font-bold text-2xl mt-1"><%= number_with_delimiter(@monthly_billed) %>円</p>
    </div>
    <div class="rounded-lg border border-gray-200 p-4">
      <p class="text-sm text-gray-500">未入金残高</p>
      <p class="font-bold text-2xl mt-1"><%= number_with_delimiter(@unpaid_balance) %>円</p>
      <p class="text-sm mt-1"><%= link_to "未入金一覧を見る", unpaid_invoices_path, class: "text-blue-600 hover:underline" %></p>
    </div>
    <div class="rounded-lg border border-gray-200 p-4">
      <p class="text-sm text-gray-500">期限超過の請求書</p>
      <p class="font-bold text-2xl mt-1"><%= @overdue_count %>件</p>
    </div>
  </div>
</div>
