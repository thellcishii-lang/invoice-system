<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">お申し込み内容の確認</h1>

  <p class="text-gray-700 mt-4">以下の内容でお申し込みします。よろしければ「お支払いへ進む」を押してください。</p>

  <dl class="mt-6 space-y-4">
    <div>
      <dt class="text-sm text-gray-500">会社名</dt>
      <dd class="font-medium mt-1"><%= @application.company_name %></dd>
    </div>
    <div>
      <dt class="text-sm text-gray-500">ご担当者名</dt>
      <dd class="font-medium mt-1"><%= @application.contact_name %></dd>
    </div>
    <div>
      <dt class="text-sm text-gray-500">メールアドレス</dt>
      <dd class="font-medium mt-1"><%= @application.email %></dd>
    </div>
    <div>
      <dt class="text-sm text-gray-500">お支払いプラン</dt>
      <dd class="font-medium mt-1"><%= @application.billing_interval_label %>：<%= number_with_delimiter(@application.plan_price_tax_excluded) %>円（税別）</dd>
    </div>
  </dl>

  <%# 決済（Stripe）へ画面遷移するため Turbo を無効化する %>
  <%= form_with model: @application, url: signups_path, data: { turbo: false }, class: "contents" do |form| %>
    <%= form.hidden_field :edition %>
    <%= form.hidden_field :billing_interval %>
    <%= form.hidden_field :company_name %>
    <%= form.hidden_field :contact_name %>
    <%= form.hidden_field :email %>
    <%= form.hidden_field :agreed_to_terms, value: "1" %>

    <div class="mt-8 flex items-center gap-4">
      <%= form.submit "お支払いへ進む", class: "btn btn-primary" %>
      <%= link_to "入力に戻る", new_signup_path, class: "text-gray-700 underline hover:no-underline" %>
    </div>
  <% end %>
</div>
