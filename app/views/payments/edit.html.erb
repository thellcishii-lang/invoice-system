<div class="mx-auto md:w-5/6 w-full">
  <h1 class="font-bold text-3xl mb-5">入金の編集</h1>
  <p class="text-gray-500 mb-5"><%= @document.kind_label %> <%= @document.number %>（<%= @document.client.name %>）への入金</p>

  <%= render "form", document: @document, payment: @payment %>

  <div class="mt-8">
    <%= link_to "請求書に戻る", @document, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>
