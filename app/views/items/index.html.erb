<div class="w-full">
  <div class="flex items-center justify-between mb-5 flex-wrap gap-2">
    <h1 class="font-bold text-3xl">品目</h1>
    <div class="flex gap-2">
      <%= link_to "分類を追加", new_item_category_path, class: "rounded-md px-3.5 py-2.5 bg-gray-800 hover:bg-gray-700 text-white font-medium" %>
      <%= link_to "新規登録", new_item_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    </div>
  </div>

  <div class="border border-gray-200 rounded-lg p-4 mb-6">
    <h2 class="font-bold text-lg mb-2">分類（全体像）</h2>
    <div class="py-1.5 px-2 rounded-md <%= @selected.nil? ? "bg-blue-50" : "hover:bg-gray-50" %>">
      <%= link_to "すべて", items_path, class: "hover:underline #{@selected.nil? ? "font-bold text-blue-700" : "text-gray-800"}" %>
      <span class="text-xs text-gray-500"><%= @all_count %>件</span>
    </div>
    <% (@children_by_parent[nil] || []).each do |root| %>
      <%= render "category_node", category: root, depth: 0 %>
    <% end %>
    <div class="py-1.5 px-2 rounded-md <%= @selected == :none ? "bg-blue-50" : "hover:bg-gray-50" %>">
      <%= link_to "未分類", items_path(category: "none"), class: "hover:underline #{@selected == :none ? "font-bold text-blue-700" : "text-gray-800"}" %>
      <span class="text-xs text-gray-500"><%= @uncategorized_count %>件</span>
    </div>
    <% if @selected_category %>
      <p class="text-sm text-gray-600 mt-3 border-t border-gray-100 pt-3">
        「<%= @selected_category.path_name %>」とその配下の品目を表示しています（<%= @items.size %>件）。
      </p>
    <% elsif @selected == :none %>
      <p class="text-sm text-gray-600 mt-3 border-t border-gray-100 pt-3">未分類の品目を表示しています（<%= @items.size %>件）。</p>
    <% end %>
  </div>

  <% if @items.empty? %>
    <p class="text-gray-500">品目はまだ登録されていません。</p>
  <% else %>
    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-gray-200 text-sm text-gray-500">
          <th class="py-2 pr-4">品目コード</th>
          <th class="py-2 pr-4">品番</th>
          <th class="py-2 pr-4">品名</th>
          <th class="py-2 pr-4">分類</th>
          <th class="py-2 pr-4">単価（税抜）</th>
          <th class="py-2 pr-4">単位</th>
          <th class="py-2 pr-4">税率</th>
          <th class="py-2 pr-4">状態</th>
          <th class="py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% @items.each do |item| %>
          <tr class="border-b border-gray-100">
            <td class="py-2 pr-4 font-mono"><%= item.code %></td>
            <td class="py-2 pr-4 font-mono text-sm whitespace-nowrap"><%= item.part_number %></td>
            <td class="py-2 pr-4"><%= link_to item.name, item, class: "text-blue-600 hover:underline" %></td>
            <td class="py-2 pr-4 text-sm text-gray-600"><%= item.item_category ? item.item_category.path_name : "未分類" %></td>
            <td class="py-2 pr-4"><%= number_with_delimiter(item.unit_price) %>円</td>
            <td class="py-2 pr-4"><%= item.unit %></td>
            <td class="py-2 pr-4"><%= item.standard? ? "標準（10%）" : "軽減（8%）" %></td>
            <td class="py-2 pr-4"><%= item.active? ? "有効" : "無効" %></td>
            <td class="py-2 text-right"><%= link_to "編集", edit_item_path(item), class: "text-gray-700 hover:underline text-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
