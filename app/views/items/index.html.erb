<div class="w-full">
  <div class="flex items-center justify-between mb-5">
    <h1 class="font-bold text-3xl">品目</h1>
    <%= link_to "新規登録", new_item_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <% if @items.empty? %>
    <p class="text-gray-500">品目はまだ登録されていません。</p>
  <% else %>
    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-gray-200 text-sm text-gray-500">
          <th class="py-2 pr-4">品目コード</th>
          <th class="py-2 pr-4">品名</th>
          <th class="py-2 pr-4">単価（税抜）</th>
          <th class="py-2 pr-4">単位</th>
          <th class="py-2 pr-4">税率</th>
          <th class="py-2 pr-4">状態</th>
          <th class="py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% @items.each do |item| %>
          <tr class="border-b border-gray-100">
            <td class="py-2 pr-4 font-mono"><%= item.code %></td>
            <td class="py-2 pr-4"><%= link_to item.name, item, class: "text-blue-600 hover:underline" %></td>
            <td class="py-2 pr-4"><%= number_with_delimiter(item.unit_price) %>円</td>
            <td class="py-2 pr-4"><%= item.unit %></td>
            <td class="py-2 pr-4"><%= item.standard? ? "標準（10%）" : "軽減（8%）" %></td>
            <td class="py-2 pr-4"><%= item.active? ? "有効" : "無効" %></td>
            <td class="py-2 text-right"><%= link_to "編集", edit_item_path(item), class: "text-gray-700 hover:underline text-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
