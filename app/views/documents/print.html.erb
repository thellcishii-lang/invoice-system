<% content_for(:title, "#{@document.kind_label} #{@document.number}") %>
<% tenant = @document.tenant %>
<% band_color = band_color_for(@document) %>
<% band_text_color = band_text_color_for(@document) %>
<% if tenant.document_striped? || document_pattern_style(tenant) %>
  <style>
    <% if tenant.document_striped? %>
      .items-table tbody tr:nth-child(even) td { background: #eef2f7; }
    <% end %>
    <% if document_pattern_style(tenant) %>
      .sheet { <%= document_pattern_style(tenant) %> }
    <% end %>
  </style>
<% end %>

<% if tenant.logo_image? && tenant.logo_placement_value == "top" && !@document.received_order? %>
  <div class="logo-top" style="text-align: <%= tenant.logo_alignment_value %>">
    <%= image_tag tenant.logo_image_data_uri, alt: "", class: "logo-img" %>
  </div>
<% end %>

<h1 style="background: <%= band_color %>; color: <%= band_text_color %>"><%= @document.kind_label %></h1>

<div class="meta">
  <%= @document.received_order? ? "発注日" : "発行日" %>：<%= @document.issue_date.strftime("%Y年%m月%d日") %><br>
  番号：<%= @document.number %>
  <% if @document.invoice? && @document.due_date %>
    <br>お支払期限：<%= @document.due_date.strftime("%Y年%m月%d日") %>
  <% end %>
  <% if @document.purchase_order? && @document.due_date %>
    <br>納期：<%= @document.due_date.strftime("%Y年%m月%d日") %>
  <% end %>
</div>

<% if @document.received_order? %>
  <%# 受注した発注書: 宛先は自社、発行するのはお客さん（印鑑を押す欄つき） %>
  <div class="parties">
    <div>
      <div class="client-name"><%= tenant.name %> 御中</div>
      <% if tenant.postal_code.present? || tenant.address.present? %>
        <div>
          <%= "〒#{tenant.postal_code}" if tenant.postal_code.present? %>
          <%= tenant.address %>
        </div>
      <% end %>
      <% if @document.title.present? %>
        <div class="section">件名：<%= @document.title %></div>
      <% end %>
      <div class="section">下記内容で発注します。</div>
    </div>

    <div class="issuer" style="padding-right: 23mm;">
      <div style="position: absolute; top: 0; right: 0; width: 21mm; height: 21mm; border: 1px solid #999; color: #bbb; display: flex; align-items: center; justify-content: center; font-size: 15px;">印</div>
      <div><strong><%= @document.client.name %></strong></div>
      <% if @document.client.postal_code.present? %><div>〒<%= @document.client.postal_code %></div><% end %>
      <% if @document.client.address.present? %><div><%= @document.client.address %></div><% end %>
      <% if @document.client.phone.present? %><div>TEL: <%= @document.client.phone %></div><% end %>
      <% if @document.client.registration_number.present? %>
        <div>登録番号：<%= @document.client.registration_number %></div>
      <% end %>
    </div>
  </div>
<% else %>
<div class="parties">
  <div>
    <div class="client-name"><%= @document.client.name %> 様</div>
    <% if @document.client.postal_code.present? || @document.client.address.present? %>
      <div>
        <%= "〒#{@document.client.postal_code}" if @document.client.postal_code.present? %>
        <%= @document.client.address %>
      </div>
    <% end %>
    <% if @document.title.present? %>
      <div class="section">件名：<%= @document.title %></div>
    <% end %>
    <div class="section">下記の通り<%= @document.kind_label.sub(/書$/, "") %>申し上げます。</div>
  </div>

  <div class="issuer<%= " with-seal" if tenant.seal_image? %>">
    <% if tenant.seal_image? %>
      <%= image_tag tenant.seal_image_data_uri, alt: "", class: "seal" %>
    <% end %>
    <div><strong><%= tenant.name %></strong></div>
    <% if tenant.postal_code.present? %><div>〒<%= tenant.postal_code %></div><% end %>
    <% if tenant.address.present? %><div><%= tenant.address %></div><% end %>
    <% if tenant.phone.present? %><div>TEL: <%= tenant.phone %></div><% end %>
    <% if tenant.invoice_registration_number.present? %>
      <div>登録番号：<%= tenant.invoice_registration_number %></div>
    <% end %>
  </div>
</div>
<% end %>

<%
  amount_label = { "estimate" => "お見積金額", "order" => "発注金額", "delivery" => "納品金額", "invoice" => "ご請求金額", "receipt" => "領収金額" }[@document.kind_value]
  deadline_label = { "estimate" => "見積有効期限", "order" => "納期", "invoice" => "お支払期限" }[@document.kind_value]
%>
<table class="summary-table">
  <tr>
    <th style="background: <%= band_color %>"><%= amount_label %></th>
    <th style="background: <%= band_color %>">消費税（<%= tenant.inclusive? ? "内税" : "外税" %>）</th>
    <% if deadline_label && @document.due_date %>
      <th style="background: <%= band_color %>"><%= deadline_label %></th>
    <% end %>
  </tr>
  <tr>
    <td class="amount"><%= number_with_delimiter(@document.total) %>円（税込）</td>
    <td><%= number_with_delimiter(@document.tax_amount) %>円</td>
    <% if deadline_label && @document.due_date %>
      <td><%= @document.due_date.strftime("%Y年%m月%d日") %></td>
    <% end %>
  </tr>
</table>

<% if (@document.estimate? || @document.invoice?) && tenant.bank_details_text.present? %>
  <div class="section">
    <div>お振込先</div>
    <div class="notes"><%= tenant.bank_details_text %></div>
  </div>
<% end %>

<table class="items-table">
  <thead>
    <tr>
      <th>品名</th>
      <th class="right" style="width: 70px;">数量</th>
      <th style="width: 50px;">単位</th>
      <th class="right" style="width: 110px;">単価<%= tenant.inclusive? ? "（税込）" : "（税抜）" %></th>
      <th style="width: 50px;">税率</th>
      <th class="right" style="width: 120px;">金額</th>
    </tr>
  </thead>
  <tbody>
    <% @document.document_lines.each do |line| %>
      <tr>
        <td><%= line.name %></td>
        <td class="right"><%= format_quantity(line.quantity) %></td>
        <td><%= line.unit %></td>
        <td class="right"><%= number_with_delimiter(line.unit_price) %>円</td>
        <td><%= tax_rate_label(line.tax_rate) %></td>
        <td class="right"><%= number_with_delimiter(line.amount) %>円</td>
      </tr>
    <% end %>
  </tbody>
</table>

<table class="totals">
  <tr><td>小計（税抜）</td><td class="right"><%= number_with_delimiter(@document.subtotal) %>円</td></tr>
  <tr><td>消費税（<%= tenant.inclusive? ? "内税" : "外税" %>）</td><td class="right"><%= number_with_delimiter(@document.tax_amount) %>円</td></tr>
  <tr class="grand-total"><td>合計（税込）</td><td class="right"><%= number_with_delimiter(@document.total) %>円</td></tr>
</table>

<%# 税率ごとの内訳は、税率が2種類以上混ざる請求書・領収書のときだけ出す
    （適格請求書ではその場合に必要。単一税率なら右の合計欄で足りる） %>
<% if (@document.invoice? || @document.receipt?) && @document.tax_breakdown.size >= 2 %>
  <div class="section">
    <table class="totals" style="margin-left: 0;">
      <thead>
        <tr><th>税率</th><th class="right">対象金額（税抜）</th><th class="right">消費税額</th></tr>
      </thead>
      <tbody>
        <% DocumentTaxCalculator::RATES.each_key do |tax_rate| %>
          <% next unless (group = @document.tax_breakdown[tax_rate]) %>
          <tr>
            <td><%= tax_rate_label(tax_rate) %></td>
            <td class="right"><%= number_with_delimiter(group["subtotal"]) %>円</td>
            <td class="right"><%= number_with_delimiter(group["tax"]) %>円</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<div class="remarks">
  <div class="remarks-band" style="background: <%= band_color %>; color: <%= band_text_color %>">備考</div>
  <div class="remarks-body"><%= @document.notes %></div>
</div>

<% if tenant.logo_image? && tenant.logo_placement_value == "bottom" && !@document.received_order? %>
  <div class="logo-bottom" style="text-align: <%= tenant.logo_alignment_value %>">
    <%= image_tag tenant.logo_image_data_uri, alt: "", class: "logo-img" %>
  </div>
<% end %>
