<div class="w-full">
  <div class="flex items-center justify-between mb-5">
    <h1 class="font-bold text-3xl"><%= @kind ? Document::KIND_LABELS[@kind] : "帳票" %></h1>
    <%= link_to "新規作成", new_document_path(kind: @kind), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <% if @documents.empty? %>
    <p class="text-gray-500">帳票はまだありません。</p>
  <% else %>
    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-gray-200 text-sm text-gray-500">
          <th class="py-2 pr-4">番号</th>
          <% if @kind.nil? %><th class="py-2 pr-4">種別</th><% end %>
          <th class="py-2 pr-4">発行日</th>
          <th class="py-2 pr-4">取引先</th>
          <th class="py-2 pr-4">件名</th>
          <th class="py-2 pr-4 text-right">合計（税込）</th>
          <th class="py-2 pr-4">状態</th>
          <th class="py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% @documents.each do |document| %>
          <tr class="border-b border-gray-100">
            <td class="py-2 pr-4 font-mono"><%= link_to document.number, document, class: "text-blue-600 hover:underline" %></td>
            <% if @kind.nil? %><td class="py-2 pr-4"><%= document.kind_label %></td><% end %>
            <td class="py-2 pr-4"><%= document.issue_date %></td>
            <td class="py-2 pr-4"><%= document.client.name %></td>
            <td class="py-2 pr-4"><%= document.title %></td>
            <td class="py-2 pr-4 text-right"><%= number_with_delimiter(document.total) %>円</td>
            <td class="py-2 pr-4"><%= document.status_label %></td>
            <td class="py-2 text-right"><%= link_to "編集", edit_document_path(document), class: "text-gray-700 hover:underline text-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
