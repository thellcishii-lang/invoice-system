<% if recurring_document.errors.any? %>
  <div class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg">
    <ul>
      <% recurring_document.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: recurring_document, class: "contents" do |form| %>
  <% if recurring_document.new_record? %>
    <div class="my-5">
      <%= form.label :template_document_id, "テンプレートにする請求書" %>
      <%= form.collection_select :template_document_id, @templates, :id, ->(doc) { "#{doc.number} #{doc.client.name} #{doc.title}" },
            { prompt: "選択してください" }, required: true, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
      <p class="text-sm text-gray-500 mt-1">取引先・件名・明細はこの請求書からコピーされます。</p>
    </div>
  <% else %>
    <div class="my-5 text-sm">
      <span class="text-gray-500">テンプレート：</span>
      <%= link_to "#{recurring_document.template_document.number} #{recurring_document.template_document.title}",
            recurring_document.template_document, class: "text-blue-600 hover:underline" %>
      （<%= recurring_document.client.name %>）
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :day_of_month, "毎月の実行日" %>
    <div class="flex items-center gap-2 mt-2">
      <%= form.number_field :day_of_month, in: 1..28, required: true, class: "shadow-sm rounded-md border border-gray-400 px-3 py-2 w-24" %>
      <span>日</span>
    </div>
    <p class="text-sm text-gray-500 mt-1">月末日のブレを避けるため、28日まで指定できます。</p>
  </div>

  <div class="my-5">
    <%= form.label :send_method, "送信方法" %>
    <%= form.select :send_method,
          RecurringDocument::SEND_METHOD_LABELS.map { |value, label| [ label, value ] },
          {}, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    <p class="text-sm text-gray-500 mt-1">作成した請求書を、その方法で自動送信します。送信先は取引先に登録したメールアドレス／FAX番号です。送れなかった場合は送信履歴に残り、後から手動で再送できます。</p>
  </div>

  <div class="my-5">
    <%= form.label :send_template_id, "送り状テンプレート" %>
    <%= form.select :send_template_id,
          [ [ "標準の文面", nil ] ] + Current.tenant.send_templates.order(:channel, :id).map { |t| [ "#{t.name}（#{t.channel_label}）", t.id ] },
          {}, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    <p class="text-sm text-gray-500 mt-1">送信方法と種類（メール／FAX）が一致するテンプレートだけが使われます。</p>
  </div>

  <% unless recurring_document.new_record? %>
    <div class="my-5">
      <label class="flex items-center gap-2">
        <%= form.check_box :active, class: "rounded border-gray-400" %>
        有効（チェックを外すと自動作成を止めます）
      </label>
    </div>
  <% end %>

  <div class="flex gap-2">
    <%= form.submit recurring_document.new_record? ? "登録する" : "更新する", class: "btn btn-primary" %>
    <%= link_to "キャンセル", recurring_documents_path, class: "btn" %>
  </div>
<% end %>
