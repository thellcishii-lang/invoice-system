<% if item_category.errors.any? %>
  <div class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg">
    <ul>
      <% item_category.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: item_category, class: "contents" do |form| %>
  <% if item_category.persisted? %>
    <div class="my-5">
      <p class="text-sm text-gray-500">分類コード（自動採番）</p>
      <p class="mt-1 font-mono"><%= item_category.full_code %></p>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name, "分類名" %>
    <%= form.text_field :name, required: true, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :parent_id, "親分類" %>
    <%= form.select :parent_id, [ [ "（なし＝最上位）", nil ] ] + @parent_options, {}, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    <p class="text-gray-500 text-sm mt-1">親分類の下にぶら下げる場合は選んでください。空欄なら最上位の分類です。</p>
  </div>

  <div class="my-5">
    <%= form.label :position, "並び順" %>
    <%= form.number_field :position, step: 1, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    <p class="text-gray-500 text-sm mt-1">同じ階層の中での並び順です。小さい数字が先に表示されます。</p>
  </div>

  <div class="inline">
    <%= form.submit item_category.persisted? ? "更新する" : "登録する", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  </div>
  <%= link_to "戻る", items_path, class: "ml-2 text-gray-700 hover:underline" %>
<% end %>
