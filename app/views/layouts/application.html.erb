<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "請求書システム（仮）" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Invoice System">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <header class="bg-slate-800 text-white shadow">
        <div class="container mx-auto px-5 py-3 flex items-center gap-4 flex-wrap">
          <span class="font-bold whitespace-nowrap shrink-0">請求書システム（仮）</span>
          <span class="text-slate-300 text-sm whitespace-nowrap shrink-0"><%= Current.tenant&.name %></span>
          <nav class="ml-auto flex items-center gap-4 text-sm flex-wrap">
            <%= link_to "ダッシュボード", root_path, class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "見積書", documents_path(kind: "estimate"), class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "発注書", documents_path(kind: "order"), class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "納品書", documents_path(kind: "delivery"), class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "請求書", documents_path(kind: "invoice"), class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "領収書", documents_path(kind: "receipt"), class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "定期請求", recurring_documents_path, class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "未入金一覧", unpaid_invoices_path, class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "レポート", report_path, class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "送信履歴", document_deliveries_path, class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "予約配信", scheduled_deliveries_path, class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "送り状", send_templates_path, class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "取引先", clients_path, class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "品目", items_path, class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= link_to "事業者マスター", setting_path, class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap" %>
            <%= button_to "ログアウト", session_path, method: :delete, class: "text-slate-100 hover:text-white hover:underline whitespace-nowrap cursor-pointer" %>
          </nav>
        </div>
      </header>
    <% end %>

    <main class="container mx-auto mt-10 px-5">
      <% if notice = flash[:notice] %>
        <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
      <% end %>
      <% if alert = flash[:alert] %>
        <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block" id="alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
