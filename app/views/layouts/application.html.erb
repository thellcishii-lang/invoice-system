<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "見積・請求書システム" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Invoice System">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <% current_kind = case controller_name
                        when "documents" then (@kind || @document&.kind_value)
                        when "document_templates" then @kind
                        end %>
      <div class="min-h-screen flex flex-col">
        <header class="bg-white border-b border-gray-100 shadow-[0_2px_16px_-8px_rgba(15,23,42,0.28)] relative z-10 flex items-center gap-4 px-5 py-2.5">
          <span class="font-bold text-slate-800 whitespace-nowrap">見積・請求書システム</span>
          <div class="ml-auto flex items-center gap-4 text-sm">
            <span class="text-gray-600 whitespace-nowrap"><%= Current.tenant&.name %></span>
            <%= button_to "ログアウト", session_path, method: :delete, class: "text-gray-500 hover:text-gray-800 hover:underline whitespace-nowrap cursor-pointer" %>
          </div>
        </header>

        <div class="flex flex-1 items-stretch">
          <aside class="w-52 shrink-0 bg-white border-r border-gray-100 shadow-[2px_0_16px_-10px_rgba(15,23,42,0.25)] py-2">
            <nav>
              <%= sidebar_link_to "ダッシュボード", root_path, active: controller_name == "dashboard" %>

              <%= sidebar_heading "帳票" %>
              <% Document::KINDS.each do |kind_value| %>
                <% kind_active = current_kind == kind_value %>
                <details class="group" <%= "open" if kind_active %>>
                  <summary class="flex items-center px-4 py-2 text-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden <%= kind_active ? "font-bold text-blue-700" : "text-gray-700 hover:bg-gray-100 hover:text-gray-900" %>">
                    <span><%= Document::KIND_LABELS[kind_value] %></span>
                    <span class="ml-auto text-gray-400 transition-transform duration-150 group-open:rotate-90">›</span>
                  </summary>
                  <div>
                    <%= sidebar_sub_link_to "一覧", documents_path(kind: kind_value), active: controller_name == "documents" && kind_active %>
                    <%= sidebar_sub_link_to "テンプレート", document_templates_path(kind: kind_value), active: controller_name == "document_templates" && kind_active %>
                  </div>
                </details>
              <% end %>

              <%= sidebar_heading "送信" %>
              <%= sidebar_link_to "定期請求", recurring_documents_path, active: controller_name == "recurring_documents" %>
              <%= sidebar_link_to "予約配信", scheduled_deliveries_path, active: controller_name == "scheduled_deliveries" %>
              <%= sidebar_link_to "送信履歴", document_deliveries_path, active: controller_name == "document_deliveries" %>

              <%= sidebar_heading "テンプレート" %>
              <%= sidebar_link_to "メールテンプレート", send_templates_path(channel: "email"), active: controller_name == "send_templates" && @channel == "email" %>
              <%= sidebar_link_to "FAXテンプレート", send_templates_path(channel: "fax"), active: controller_name == "send_templates" && @channel == "fax" %>

              <%= sidebar_heading "管理" %>
              <%= sidebar_link_to "未入金一覧", unpaid_invoices_path, active: controller_name == "unpaid_invoices" %>
              <%= sidebar_link_to "レポート", report_path, active: controller_name == "reports" %>

              <%= sidebar_heading "マスター・設定" %>
              <%= sidebar_link_to "取引先", clients_path, active: controller_name == "clients" %>
              <%= sidebar_link_to "品目", items_path, active: controller_name == "items" %>
              <%= sidebar_link_to "メンバー", members_path, active: controller_name == "members" %>
              <%= sidebar_link_to "事業者マスター", setting_path, active: controller_name == "settings" %>
            </nav>
          </aside>

          <main class="flex-1 min-w-0 bg-[#edf0f5] px-6 py-6">
            <% if notice = flash[:notice] %>
              <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-lg inline-block shadow-sm" id="notice"><%= notice %></p>
            <% end %>
            <% if alert = flash[:alert] %>
              <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block shadow-sm" id="alert"><%= alert %></p>
            <% end %>

            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="container mx-auto mt-10 px-5">
        <% if notice = flash[:notice] %>
          <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
        <% end %>
        <% if alert = flash[:alert] %>
          <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block" id="alert"><%= alert %></p>
        <% end %>

        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
