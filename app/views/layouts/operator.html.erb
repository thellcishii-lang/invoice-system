<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>運営者ダッシュボード | 見積・請求書システム</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <style>
      body { font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Noto Sans JP", sans-serif; margin: 0; background: #f1f5f9; color: #1e293b; }
      header { background: #1e2a3a; color: #fff; padding: 12px 24px; display: flex; align-items: center; gap: 24px; }
      header .brand { font-weight: bold; }
      header nav a { color: #cbd5e1; text-decoration: none; font-size: 14px; margin-right: 16px; }
      header nav a:hover { color: #fff; }
      header form { margin-left: auto; }
      header button { background: none; border: none; color: #cbd5e1; cursor: pointer; font-size: 14px; }
      main { max-width: 1100px; margin: 0 auto; padding: 24px 16px; }
      .notice { background: #ecfdf5; color: #065f46; padding: 10px 14px; border-radius: 8px; font-size: 14px; }
      .alert { background: #fef2f2; color: #b91c1c; padding: 10px 14px; border-radius: 8px; font-size: 14px; }
      .cards { display: flex; gap: 12px; flex-wrap: wrap; margin: 16px 0; }
      .card { background: #fff; border-radius: 10px; padding: 16px 20px; min-width: 150px; box-shadow: 0 1px 2px rgba(0,0,0,.06); }
      .card .label { font-size: 12px; color: #64748b; }
      .card .value { font-size: 24px; font-weight: bold; margin-top: 4px; }
      table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,.06); font-size: 14px; }
      th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #e2e8f0; }
      th { color: #64748b; font-weight: 600; font-size: 12px; }
      .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
      .badge-active { background: #dcfce7; color: #166534; }
      .badge-suspended { background: #fee2e2; color: #991b1b; }
      .badge-cancelled { background: #e2e8f0; color: #475569; }
      .badge-none { background: #e2e8f0; color: #475569; }
      input[type=email], input[type=password] { width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; margin-top: 4px; box-sizing: border-box; }
      .btn { background: #1e2a3a; color: #fff; border: none; padding: 9px 20px; border-radius: 6px; cursor: pointer; font-size: 14px; }
      .login-box { max-width: 380px; margin: 60px auto; background: #fff; border-radius: 12px; padding: 28px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
      label { font-size: 14px; font-weight: 600; }
      .field { margin-bottom: 16px; }
    </style>
  </head>
  <body>
    <% if current_operator %>
      <header>
        <span class="brand">見積・請求書システム 運営者</span>
        <nav>
          <%= link_to "販売先ダッシュボード", operator_root_path %>
          <%= link_to "パスワード変更", edit_operator_password_path %>
        </nav>
        <%= button_to "ログアウト", operator_session_path, method: :delete %>
      </header>
    <% end %>
    <main>
      <% if notice %><p class="notice"><%= notice %></p><% end %>
      <% if alert %><p class="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
